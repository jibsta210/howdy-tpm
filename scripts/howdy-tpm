#!/bin/bash
# Read-only configuration guidance and explicit authentication/wallet checks.
set -uo pipefail

LIBEXECDIR=${HOWDY_TPM_LIBEXECDIR:-$(dirname "$(readlink -f "$0")")/../libexec/howdy-tpm}
CRED=${HOWDY_TPM_CRED:-/etc/howdy-tpm/secret.cred}
NAME=${HOWDY_TPM_NAME:-howdy-tpm}
SERVICE=""
TARGET_USER=${SUDO_USER:-}
PAM_DIR=/etc/pam.d
MODULE_DIR=""
KEYRING=""
WALLET=""
SHOW_STACK=0
EMIT_SHELL=0

usage(){
  cat <<'EOF'
Usage: howdy-tpm doctor|test|status [options]
  --service NAME      PAM service (required for doctor/test)
  --user USER         PAM user (defaults to sudo's invoking user)
  --keyring kwallet|gnome  Backend for a review-only doctor plan
  --module-dir PATH   PAM module directory (otherwise PAM's pkg-config libdir)
  --pam-dir PATH      Configuration directory for inspection (doctor/--show-stack)
  --cred PATH         Encrypted credential path
  --name NAME         Credential name
  --show-stack        Inspect authentication files without authenticating
  --emit-shell        Print copyable PAM setup commands (doctor only)
  --wallet NAME       After authentication, check this wallet in the current KDE session

doctor only reads files and prints a plan. It does not decrypt credentials or edit PAM.
test authenticates without supplying a password; it does not start a desktop session.
EOF
}
fail(){ printf '%s\n' "$*" >&2; return 1; }
need_root(){ [[ $EUID -eq 0 ]] || { fail "run as root: sudo howdy-tpm $COMMAND"; exit 1; }; }

COMMAND=${1:-}
if [[ $COMMAND == -h || $COMMAND == --help || -z $COMMAND ]]; then usage; exit 0; fi
shift
while [[ $# -gt 0 ]]; do
  case $1 in
    --service|--user|--keyring|--module-dir|--pam-dir|--cred|--name|--wallet)
      [[ $# -ge 2 && -n $2 ]] || { fail "missing value for $1"; exit 2; }
      case $1 in
        --service) SERVICE=$2;; --user) TARGET_USER=$2;; --keyring) KEYRING=$2;;
        --module-dir) MODULE_DIR=$2;; --pam-dir) PAM_DIR=$2;;
        --cred) CRED=$2;; --name) NAME=$2;; --wallet) WALLET=$2;;
      esac
      shift 2;;
    --show-stack) SHOW_STACK=1; shift;;
    --emit-shell) EMIT_SHELL=1; shift;;
    -h|--help) usage; exit 0;;
    *) fail "unknown option: $1"; exit 2;;
  esac
done
[[ $EMIT_SHELL == 0 || $COMMAND == doctor ]] || { fail '--emit-shell is doctor-only.'; exit 2; }

inspect_stack(){
  python3 "$LIBEXECDIR/flatten-pam.py" "$SERVICE" --pam-dir "$PAM_DIR" "$@"
}

doctor(){
  if [[ -z $MODULE_DIR ]]; then
    local libdir
    libdir=$(pkg-config --variable=libdir pam 2>/dev/null) || {
      fail 'PAM metadata unavailable; install development files or pass --module-dir.'; return 1;
    }
    [[ -n $libdir ]] || { fail 'PAM libdir unavailable; pass --module-dir.'; return 1; }
    MODULE_DIR=$libdir/security
  fi
  if [[ $EMIT_SHELL == 1 ]]; then
    [[ -n $KEYRING ]] || { fail '--emit-shell requires --keyring kwallet or gnome.'; return 2; }
    inspect_stack --emit-shell --user "$TARGET_USER" --keyring "$KEYRING" \
      --module-dir "$MODULE_DIR" --cred "$CRED" --name "$NAME"
    return
  fi
  printf 'Service: %s\nUser: %s\n' "$SERVICE" "$TARGET_USER"
  printf 'PAM modules: %s\n' "$MODULE_DIR"
  if systemd-analyze has-tpm2 >/dev/null 2>&1; then
    printf 'TPM: usable\n'
  else
    printf 'TPM: unavailable in this environment; the configuration plan can still be inspected.\n'
  fi
  if [[ -f $CRED ]]; then
    printf 'Credential: %s (%s); not decrypted by doctor\n' "$CRED" "$(stat -c '%U:%G %a' "$CRED")"
  else
    printf 'Credential not readable or not enrolled: %s\n' "$CRED"
  fi
  if [[ -z $KEYRING ]]; then
    inspect_stack || return
    fail 'Pass --keyring kwallet or --keyring gnome to request a configuration plan.'
    return 1
  fi
  inspect_stack --plan --user "$TARGET_USER" --keyring "$KEYRING" \
    --module-dir "$MODULE_DIR" --cred "$CRED" --name "$NAME"
}

run_test(){
  if [[ $SHOW_STACK == 1 ]]; then inspect_stack; return; fi
  [[ $PAM_DIR == /etc/pam.d ]] || { fail '--pam-dir is inspection-only; test uses the real service.'; return 2; }
  need_root
  [[ -x $LIBEXECDIR/pamtest ]] || { fail 'Authentication helper missing; run make install.'; return 1; }
  local rc
  "$LIBEXECDIR/pamtest" "$SERVICE" "$TARGET_USER"
  rc=$?
  printf 'Failed attempts may count toward faillock; no counters were reset.\n'
  if [[ $rc != 0 ]]; then return "$rc"; fi
  printf 'Authentication passed. A new desktop session was not started.\n'
  if [[ -z $WALLET ]]; then
    printf 'Wallet unlock: not checked. Use --wallet NAME for a separate current-session check.\n'
    return 0
  fi
  local uid result
  uid=$(id -u "$TARGET_USER") || return 1
  result=$(runuser -u "$TARGET_USER" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    busctl --user --auto-start=no call org.kde.kwalletd6 /modules/kwalletd6 \
    org.kde.KWallet isOpen s "$WALLET") || return 1
  if [[ $result == 'b true' ]]; then
    printf 'Current-session wallet %s: open (may already have been open before this test).\n' "$WALLET"
    return 0
  fi
  fail "Current-session wallet $WALLET: closed or unverified."
}

status(){
  need_root
  [[ -f $CRED ]] || { fail "no credential at $CRED"; return 1; }
  local length
  if ! length=$(systemd-creds decrypt --name="$NAME" "$CRED" - 2>/dev/null | wc -c); then
    fail 'Credential does not decrypt.'; return 1
  fi
  [[ $length -gt 0 ]] || { fail 'Credential is empty.'; return 1; }
  printf 'Credential decrypts (%s bytes); value not displayed.\n' "$length"
}

case $COMMAND in
  doctor|test)
    [[ -n $SERVICE && -n $TARGET_USER ]] || { fail '--service and --user are required (or invoke via sudo for the user).'; exit 2; }
    [[ $SERVICE =~ ^[a-zA-Z0-9_-]+$ ]] || { fail 'invalid PAM service name'; exit 2; }
    id -u "$TARGET_USER" >/dev/null 2>&1 || { fail "unknown user: $TARGET_USER"; exit 2; }
    if [[ $COMMAND == doctor ]]; then doctor; else run_test; fi;;
  status) status;;
  *) usage >&2; exit 2;;
esac
